# ==============================================================================
# AWS EXTERNAL BOX (/opt/closy-aws/.env.aws) — Phase 2
# Fill in and copy to /opt/closy-aws/.env.aws (chmod 600). NEVER commit (gitignored).
# Managed hosts come from Supabase / Redis Cloud / CloudAMQP dashboards (docs/operations/aws-runbook.md Step 2).
# SaaS keys (Brevo/Cloudinary/AI) are COPIED from the VPS .env.production
# (shared quota). payOS is NOT shared: the AWS box uses its own payment channel.
# Image pins come from .env.deploy (written by deploy-aws.yml) — do NOT set them here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# AWS box uses the vps profile values (no Cloud Run managed profile).
# APP_MODE is hardcoded per container in docker-compose.aws.yml (http/worker).
SERVER_ENV=vps
PORT=
# Container timezone.
TZ=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# 2. DOMAINS & INGRESS
# ------------------------------------------------------------------------------
API_V2_DOMAIN=api-v2.closy.hycat.online
NGINX_CLIENT_MAX_BODY_SIZE=20m
# Inter-service gRPC (Commerce -> Account/AI, AI -> Account) targets the *-http
# containers on THIS box — hardcoded in docker-compose.aws.yml (explicit
# environment wins). Do NOT set INGRESS_*_URL here and do NOT copy the VPS values.
# Cloud audience. Leave empty on the AWS box.
INGRESS_TOKEN_AUDIENCE=
# REQUIRED: CORS origins, comma-separated (same as VPS).
FRONT_END_ORIGIN=
# Optional: Swagger UI gate (enforced when SERVER_ENV is not local/dev).
SWAGGER_ACCESS_CODE=

# ------------------------------------------------------------------------------
# 3. DATABASE — Supabase pooler/direct (never local hostnames)
# ------------------------------------------------------------------------------
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_NAME=postgres
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require
DB_LISTENER_HOST=db.<project-ref>.supabase.co
DB_LISTENER_PORT=5432
DB_LISTENER_SSLMODE=require
# Optional: drill-only schema (drill_<date>_<n>); empty = no drill.
DB_DRILL_SCHEMA=
# Optional: per-service Goose table (compose sets it per container); empty = account default.
DATABASE_MIGRATION_TABLE=

# ------------------------------------------------------------------------------
# 4. REDIS — Redis Cloud
# ------------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=

# ------------------------------------------------------------------------------
# 5. RABBITMQ — CloudAMQP (amqps)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=
RABBITMQ_PORT=5671
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_TLS_ENABLED=true
RABBITMQ_MANAGEMENT_TLS_ENABLED=true

# ------------------------------------------------------------------------------
# 6. ELASTICSEARCH — NOT run on the AWS box
# ------------------------------------------------------------------------------
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_ADDRESSES=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# ------------------------------------------------------------------------------
# 7. JWT
# ------------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_SECRET=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH (Social Login)
# ------------------------------------------------------------------------------
# Comma-separated OAuth client IDs: web, iOS, Android.
GOOGLE_CLIENT_IDS=
# Web Authorization Code flow only; leave empty if web uses ID token (GIS).
GOOGLE_CLIENT_SECRET=
# Backend callback URL; must be registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=
# Optional: CSRF state TTL in minutes (default 10 in configs/config.yaml).
GOOGLE_STATE_TTL_MINUTES=

# ------------------------------------------------------------------------------
# 9. EMAIL SMTP
# ------------------------------------------------------------------------------
EMAIL_SENDER_EMAIL=
EMAIL_SMTP_USER=
EMAIL_SMTP_KEY=
EMAIL_REPLY_TO=

# ------------------------------------------------------------------------------
# 10. PAYOS
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ENDPOINT=https://api-merchant.payos.vn

# ------------------------------------------------------------------------------
# 11. CLOUDINARY
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_URL=https://api.cloudinary.com

# ------------------------------------------------------------------------------
# 12. AI PROVIDERS
# ------------------------------------------------------------------------------
# --- VISION ---
VISION_PRIMARY_PROVIDER=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_ENDPOINT=
VISION_PRIMARY_MODEL=
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_ENDPOINT=
VISION_FALLBACK_MODEL=

# --- EMBEDDING ---
EMBEDDING_PRIMARY_PROVIDER=
EMBEDDING_PRIMARY_API_KEY=
EMBEDDING_PRIMARY_ENDPOINT=
EMBEDDING_PRIMARY_MODEL=
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_ENDPOINT=
EMBEDDING_FALLBACK_MODEL=

# --- CHAT_TEXT ---
CHAT_TEXT_PRIMARY_PROVIDER=
CHAT_TEXT_PRIMARY_API_KEY=
CHAT_TEXT_PRIMARY_ENDPOINT=
CHAT_TEXT_PRIMARY_MODEL=
CHAT_TEXT_FALLBACK_PROVIDER=
CHAT_TEXT_FALLBACK_API_KEY=
CHAT_TEXT_FALLBACK_ENDPOINT=
CHAT_TEXT_FALLBACK_MODEL=

# --- RECOMMENDATION_TEXT ---
RECOMMENDATION_TEXT_PRIMARY_PROVIDER=
RECOMMENDATION_TEXT_PRIMARY_API_KEY=
RECOMMENDATION_TEXT_PRIMARY_ENDPOINT=
RECOMMENDATION_TEXT_PRIMARY_MODEL=
RECOMMENDATION_TEXT_FALLBACK_PROVIDER=
RECOMMENDATION_TEXT_FALLBACK_API_KEY=
RECOMMENDATION_TEXT_FALLBACK_ENDPOINT=
RECOMMENDATION_TEXT_FALLBACK_MODEL=

# --- FREE_TEXT ---
FREE_TEXT_PRIMARY_PROVIDER=google
FREE_TEXT_PRIMARY_API_KEY=
FREE_TEXT_PRIMARY_ENDPOINT=
FREE_TEXT_PRIMARY_MODEL=
FREE_TEXT_FALLBACK_PROVIDER=
FREE_TEXT_FALLBACK_API_KEY=
FREE_TEXT_FALLBACK_ENDPOINT=
FREE_TEXT_FALLBACK_MODEL=
