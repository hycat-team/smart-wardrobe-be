# aws-local.env.example
# Copy to aws-local.env (gitignored) and fill in.
# Read automatically by the AWS env helper scripts in this folder.
# Only set what you need; scripts fall back to built-in defaults when omitted.

# Path to the VPS env used to copy shared SaaS keys (JWT/Brevo/Cloudinary/AI).
VPS_ENV_PROD=.env.production

# AWS box static IP. May be left empty and filled inside the generated .env.aws.
AWS_BOX_IP=

# SSH private key used by every ssh/scp command.
AWS_SSH_KEY_PATH=C:\Users\<you>\.ssh\LightsailDefaultKey-ap-southeast-1.pem

# GitHub repo (owner/name) that receives the AWS_* secrets.
GITHUB_REPO=hycat-team/smart-wardrobe-be

# Optional overrides for generated file locations (defaults under outcome/).
# AWS_ENV_FILE=deployments/scripts/outcome/.env.aws
# AWS_COPYBLOCK_OUT=deployments/scripts/outcome/aws-secrets-to-set.txt
# AWS_KNOWN_HOSTS=deployments/scripts/outcome/aws_known_hosts
