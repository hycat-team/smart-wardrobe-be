# aws: catch-all + :80 api-v2 (block map + :443 api-v2 nằm ở api-v2.conf.template).
server {
    listen 80 default_server;
    server_name _;

    location /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 444;
    }
}

server {
    listen 80;
    server_name ${API_V2_DOMAIN};

    location /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/${API_V2_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_V2_DOMAIN}/privkey.pem;

    return 444;
}
