# ==============================================================================
# EC2-SIDE TEMPLATE - Ollama CPU trial host (feature 032)
# Source of truth: specs/032-ollama-lightsail-trial/contracts/env-ai-trial.md section 2
#
# This file is a TEMPLATE only. It is committed because every value is a placeholder.
# Never fill in real values here. The real values live in:
#   - Terraform variables at apply time (operator machine, local state, not committed)
#   - AWS Secrets Manager for the proxy Bearer token
#   - /etc/ollama-trial/trial.env on the EC2 instance, rendered by cloud-init
# Never place the Bearer token itself in this file, in Terraform state committed to
# the repo, in a workflow log, or in any other repository artifact.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OLLAMA RUNTIME - loopback only, pinned version and model digest
# ------------------------------------------------------------------------------
# Bind address for the inference port. Keep loopback: only the Nginx proxy may call it.
OLLAMA_HOST=127.0.0.1:11434
# Model tag. Must match the digest pinned below and the value used locally.
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# Digest printed by "ollama pull" / "ollama list". Compare local and EC2 values
# before starting the measurement week.
OLLAMA_MODEL_DIGEST=sha256:<digest-from-ollama-pull>
# Ollama runtime version to install. Pin it; the bootstrap must not auto-update.
OLLAMA_VERSION=<ollama-version-pin>
# Parallel requests served by the Ollama runtime. Must match AI_TEXT_MAX_CONCURRENCY (2).
OLLAMA_NUM_PARALLEL=2
# Finite queue depth. Never leave this unbounded.
OLLAMA_MAX_QUEUE=8
# Keep the model loaded between requests during the trial week.
OLLAMA_KEEP_ALIVE=30m

# ------------------------------------------------------------------------------
# 2. PROXY - TLS termination, allowlist and ACME
# ------------------------------------------------------------------------------
# Public HTTPS port used by the Lightsail box.
PROXY_HTTPS_PORT=443
# Port 80 serves ACME challenge and redirect only. It must never proxy inference.
PROXY_ACME_PORT=80
# Static IP of the Lightsail box as a /32. Must never be 0.0.0.0/0.
# Update this value (and the security group) whenever the Lightsail static IP changes.
PROXY_ALLOWED_CIDR=<lightsail-static-ip>/32
# AWS Secrets Manager ARN holding the Bearer token shared with the Lightsail .env.aws.
# The instance profile may read this one secret only.
PROXY_BEARER_SECRET_ARN=<secret-arn>

# ------------------------------------------------------------------------------
# 3. OPERATOR NOTES (not read by the application)
# ------------------------------------------------------------------------------
# The EC2 Ollama host does not run the application. Keep email disabled if this
# template is ever reused for a service process.
EMAIL_ENABLED=false
# The proxy hostname, ACME contact email and AWS region are Terraform variables, not
# runtime env of the app; see deployments/terraform/ollama-ec2/variables.tf.
