# deployments/nginx/templates/services-redirect/api-v2-redirect.conf.template — grace period.
# api-v2.closy.hycat.online redirect 301 về api.closy.hycat.online (host canonical) trong grace
# period 14–30 ngày; cả hai host cùng phục vụ 3-service compose. Sau grace
# period: xoá bản ghi DNS api-v2. Render bằng envsubst rồi `nginx -t` + reload.

server {
    listen 80;
    server_name ${API_V2_DOMAIN};

    location /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_V2_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${API_V2_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_V2_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /var/log/nginx/access.log main_tid;

    location /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Grace period: mọi request api-v2 đi theo redirect về host canonical.
    location / {
        return 301 https://${API_DOMAIN}$request_uri;
    }
}
