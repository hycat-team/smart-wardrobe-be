# deployments/nginx/templates/api-v2.conf.template — ingress api-v2 → 3 Cloud Run (FR-028/033/036/037).
# Render bằng envsubst (xem Makefile target nginx-reload — T007), sau đó `nginx -t` + reload.
# - `api.closy` GIỮ NGUYÊN trong default.conf.template → monolith (http://backend:8080).
# - Route tới từng service nằm trong include api-v2-routes/ (single source, chi tiết prefix chốt ở T069).
# - Xác thực Nginx → Cloud Run bằng Cloud Run IAM: token helper (FR-039) cấp Google ID token,
#   Nginx inject qua header X-Serverless-Authorization; KHÔNG bật allUsers; KHÔNG ghi đè Authorization.
# - SSE: tắt buffering + timeout đọc lớn + heartbeat 15s (FR-036).

# Route map single-source: mỗi service một file location trong thư mục này (T069 populate).
# Ví dụ file account.conf:  location /api/v1/identity/ { ... proxy https://$account_run ... }

server {
    listen 80;
    server_name ${API_V2_DOMAIN};

    location /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_V2_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${API_V2_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_V2_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    # FR-054: Nginx KHÔNG rate-limit (chỉ giữ body-limit/timeout/security-header).

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Cloud Run hostname resolve động (KHÔNG pin IP — run.app đổi IP bất kỳ lúc nào).
    resolver 8.8.8.8 1.1.1.1 valid=30s;

    location /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Token helper nội bộ — mỗi service một audience (URL run.app của chính nó).
    # Chỉ Nginx gọi (internal); helper trả header X-Serverless-Authorization.
    location = /_token_helper_account {
        internal;
        proxy_pass ${TOKEN_HELPER_URL}/token?audience=${ACCOUNT_RUN_URL};
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }
    location = /_token_helper_commerce {
        internal;
        proxy_pass ${TOKEN_HELPER_URL}/token?audience=${COMMERCE_RUN_URL};
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }
    location = /_token_helper_ai {
        internal;
        proxy_pass ${TOKEN_HELPER_URL}/token?audience=${AI_RUN_URL};
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    # SSE/AI streaming (FR-036) is generated into the route map below:
    # `make nginx-routes` emits a dedicated `location ^~` per /stream or /sse
    # path with proxy_buffering off + long timeouts. Do NOT add a regex here:
    # the generated locations use `^~`, so Nginx would skip regex matching.

    # Combined Swagger docs hosted by Account (old UI + service/module
    # selectors), behind the app access-code lock.
    location ^~ /swagger {
        auth_request /_token_helper_account;
        auth_request_set $serverless_auth $upstream_http_x_serverless_authorization;
        proxy_set_header X-Serverless-Authorization $serverless_auth;
        proxy_ssl_server_name on;
        proxy_pass ${ACCOUNT_RUN_URL};
    }
    location ^~ /api-docs {
        auth_request /_token_helper_account;
        auth_request_set $serverless_auth $upstream_http_x_serverless_authorization;
        proxy_set_header X-Serverless-Authorization $serverless_auth;
        proxy_ssl_server_name on;
        proxy_pass ${ACCOUNT_RUN_URL};
    }

    # Route map tới 3 Cloud Run (T069 populate từng file service).
    include /etc/nginx/api-v2-routes/*.conf;
}
