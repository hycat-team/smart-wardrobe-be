#cloud-config
# Feature 032 - EC2 bootstrap for the Ollama CPU trial host (Ubuntu 24.04 amd64).
#
# Rendered by Terraform templatefile() from main.tf. No secret is rendered here:
# the Bearer token is fetched from Secrets Manager at boot by bootstrap.sh through
# the instance profile.
#
# Two-step apply (operator, not cloud-init):
#   1) terraform apply -target=aws_eip.ollama
#   2) create the A record for ${proxy_hostname} -> output elastic_ip
#   3) terraform apply
# If this host boots before step 2 is done, bootstrap.sh cannot obtain a
# certificate. That is expected: it leaves the ACME/HTTP config in place, writes
# /etc/ollama-trial/TLS_PENDING and exits 0 so cloud-init does not fail. Re-run
# bootstrap.sh over SSM after DNS resolves.
#
# Contract: specs/032-ollama-lightsail-trial/contracts/env-ai-trial.md section 2.
# Runtime knobs live in /etc/ollama-trial/trial.env; bootstrap.sh owns the real
# install/pull/certbot/nginx logic so a manual re-run and a fresh boot follow the
# same path.

package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - jq
  - nginx
  - certbot
  - python3-certbot-nginx
  - unzip
  - awscli
  # The CloudWatch agent is not in the Ubuntu archive; runcmd installs the
  # official .deb. The agent version is not pinned for this one-week trial: the
  # journald collector requires a 2026 release, so the official latest package is
  # used and the installed version is recorded as evidence before measurement.

write_files:
  # Runtime env contract for the host. Values come from Terraform variables; the
  # secret ARN is an identifier only, never the token itself.
  - path: /etc/ollama-trial/trial.env
    permissions: "0600"
    owner: root:root
    content: |
      # Feature 032 - generated by cloud-init. Do not edit by hand; re-apply Terraform.
      AWS_REGION=${aws_region}
      OLLAMA_HOST=${ollama_host}
      OLLAMA_MODEL=${ollama_model}
      OLLAMA_MODEL_DIGEST=${model_digest}
      OLLAMA_VERSION=${ollama_version}
      OLLAMA_NUM_PARALLEL=${ollama_num_parallel}
      OLLAMA_MAX_QUEUE=${ollama_max_queue}
      OLLAMA_KEEP_ALIVE=${ollama_keep_alive}
      OLLAMA_NUM_GPU=${ollama_num_gpu}
      PROXY_HTTPS_PORT=${proxy_https_port}
      PROXY_ACME_PORT=${proxy_acme_port}
      PROXY_ALLOWED_CIDR=${proxy_allowed_cidr}
      PROXY_HOSTNAME=${proxy_hostname}
      PROXY_ACME_EMAIL=${proxy_acme_email}
      PROXY_BEARER_SECRET_ARN=${proxy_bearer_secret_arn}
      TRIAL_DATA_DEVICE=${data_volume_device_name}
      CLOUDWATCH_LOG_RETENTION_DAYS=${cloudwatch_log_retention_days}

  # Ollama systemd drop-in. bootstrap.sh rewrites the same file from trial.env so
  # a manual re-run and the first boot converge on identical values.
  - path: /etc/systemd/system/ollama.service.d/10-trial.conf
    permissions: "0644"
    owner: root:root
    content: |
      [Service]
      Environment="OLLAMA_HOST=${ollama_host}"
      Environment="OLLAMA_NUM_PARALLEL=${ollama_num_parallel}"
      Environment="OLLAMA_MAX_QUEUE=${ollama_max_queue}"
      Environment="OLLAMA_KEEP_ALIVE=${ollama_keep_alive}"
      Environment="OLLAMA_NUM_GPU=${ollama_num_gpu}"
      Environment="OLLAMA_MODELS=/var/lib/ollama/models"

  # Bootstrap expectations: the pieces it needs before it can run.
  - path: /opt/ollama-trial/README-trial.txt
    permissions: "0644"
    owner: root:root
    content: |
      Feature 032 - Ollama CPU trial host.

      * Ollama listens on 127.0.0.1:11434 only. Never bind a public interface.
      * The only inference entry point is nginx on ${proxy_https_port}, allowed from
        ${proxy_allowed_cidr} and guarded by an exact Bearer token.
      * Port ${proxy_acme_port} serves the Let's Encrypt challenge and a redirect only.
      * /etc/ollama-trial/trial.env is the operator-editable runtime config.
      * /etc/ollama-trial/TRIAL_READY exists only after digest, TLS, pre-warm,
        thinking-off and loopback checks have all passed.
      * /etc/ollama-trial/TLS_PENDING means the certificate has not been issued yet
        (usually the A record did not exist when the host booted). Re-run
        /opt/ollama-trial/bootstrap.sh over SSM after DNS resolves.

  # Cloud-init cannot read the repository, so the bootstrap script and the proxy
  # template are carried in the user data. Both are plain strings passed through
  # templatefile(); their shell/nginx variables are not re-interpolated.
  - path: /opt/ollama-trial/bootstrap.sh
    permissions: "0755"
    owner: root:root
    content: |
${indent(6, bootstrap_script)}

  - path: /opt/ollama-trial/nginx-ollama.conf.template
    permissions: "0644"
    owner: root:root
    content: |
${indent(6, nginx_template)}

  # CloudWatch agent: Nginx access/error, Ollama journal, bootstrap and
  # cloud-init logs plus the contract CPU/RAM/disk metrics. Metric filters and the
  # dashboard are declared in main.tf; retention is enforced by the Terraform log
  # group (14 days).
  - path: /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
    permissions: "0644"
    owner: root:root
    content: |
      {
        "agent": {
          "metrics_collection_interval": 60,
          "run_as_user": "root"
        },
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/log/nginx/ollama-access.log",
                  "log_group_name": "${cloudwatch_log_group_name}",
                  "log_stream_name": "{instance_id}/nginx-access",
                  "retention_in_days": ${cloudwatch_log_retention_days}
                },
                {
                  "file_path": "/var/log/nginx/ollama-error.log",
                  "log_group_name": "${cloudwatch_log_group_name}",
                  "log_stream_name": "{instance_id}/nginx-error",
                  "retention_in_days": ${cloudwatch_log_retention_days}
                },
                {
                  "file_path": "/var/log/ollama-trial-bootstrap.log",
                  "log_group_name": "${cloudwatch_log_group_name}",
                  "log_stream_name": "{instance_id}/bootstrap",
                  "retention_in_days": ${cloudwatch_log_retention_days}
                },
                {
                  "file_path": "/var/log/cloud-init-output.log",
                  "log_group_name": "${cloudwatch_log_group_name}",
                  "log_stream_name": "{instance_id}/cloud-init",
                  "retention_in_days": ${cloudwatch_log_retention_days}
                }
              ]
            },
            "journald": {
              "collect_list": [
                {
                  "log_group_name": "${cloudwatch_log_group_name}",
                  "log_stream_name": "{instance_id}/ollama-journal",
                  "retention_in_days": ${cloudwatch_log_retention_days},
                  "units": ["ollama.service"]
                }
              ]
            }
          }
        },
        "metrics": {
          "namespace": "${cloudwatch_metric_namespace}",
          "append_dimensions": {
            "InstanceId": "$${aws:InstanceId}"
          },
          "aggregation_dimensions": [["InstanceId"], ["InstanceId", "path"]],
          "metrics_collected": {
            "cpu": {
              "totalcpu": true,
              "measurement": [
                {"name": "usage_active", "rename": "ec2_cpu_percent", "unit": "Percent"}
              ]
            },
            "mem": {
              "measurement": [
                {"name": "used", "rename": "ec2_memory_bytes", "unit": "Bytes"}
              ]
            },
            "disk": {
              "measurement": [
                {"name": "free", "rename": "ec2_disk_free_bytes", "unit": "Bytes"}
              ],
              "resources": ["/", "/var/lib/ollama"],
              "drop_device": true
            }
          }
        }
      }

runcmd:
  - [ bash, "-c", "install -d -m 0700 /opt/ollama-trial" ]
  - [ bash, "-c", "install -d -m 0755 /var/lib/ollama /var/lib/ollama/models /var/www/certbot" ]
  # Bootstrap is idempotent. It exits 0 when the certificate cannot be issued yet
  # and leaves /etc/ollama-trial/TLS_PENDING for the operator.
  - [ bash, "-lc", "/opt/ollama-trial/bootstrap.sh >> /var/log/ollama-trial-bootstrap.log 2>&1" ]
  - [ bash, "-lc", "systemctl enable nginx" ]
  # CloudWatch agent (best effort: the trial must still boot if the download fails,
  # and the day-7 report records the gap instead of pretending metrics exist).
  - [ bash, "-lc", "if ! command -v amazon-cloudwatch-agent-ctl >/dev/null 2>&1; then curl -fsSL https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb -o /tmp/amazon-cloudwatch-agent.deb && dpkg -i /tmp/amazon-cloudwatch-agent.deb; fi || true" ]
  - [ bash, "-lc", "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json || true" ]
  - [ bash, "-lc", "systemctl enable amazon-cloudwatch-agent || true" ]

final_message: "Feature 032 Ollama trial host bootstrap finished; check /etc/ollama-trial/TRIAL_READY or TLS_PENDING, then run runbook section B2."
