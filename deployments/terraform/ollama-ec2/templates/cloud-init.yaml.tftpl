#cloud-config
# Feature 032 - EC2 bootstrap for the Ollama CPU trial host (Ubuntu 24.04 amd64).
#
# Rendered by Terraform templatefile(). Every ${...} placeholder is supplied by main.tf
# (T019). No secret is rendered here: the Bearer token is fetched from Secrets Manager
# at boot by bootstrap.sh through the instance profile.
#
# TODO(T019): templatefile() must pass these keys:
#   aws_region, ollama_host, ollama_model, model_digest, ollama_version,
#   ollama_num_parallel, ollama_max_queue, ollama_keep_alive, ollama_num_gpu,
#   proxy_https_port, proxy_acme_port, proxy_allowed_cidr, proxy_hostname,
#   proxy_acme_email, proxy_bearer_secret_arn, data_volume_device_name,
#   cloudwatch_log_retention_days
#
# TODO(T020): keep this file in sync with deployments/ollama/bootstrap.sh; the script
# owns install/pull/certbot logic, cloud-init only prepares the host and the env file.

package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - jq
  - nginx
  - certbot
  - python3-certbot-nginx
  - unzip
  # TODO(T020): pin the AWS CLI v2 installer instead of the distro package if the
  # distro build cannot call secretsmanager:GetSecretValue.
  - awscli

write_files:
  # Runtime env contract for the host. Values come from Terraform variables; the
  # secret ARN is an identifier only, never the token itself.
  - path: /etc/ollama-trial/trial.env
    permissions: "0600"
    owner: root:root
    content: |
      # Feature 032 - generated by cloud-init. Do not edit by hand; re-apply Terraform.
      AWS_REGION=${aws_region}
      OLLAMA_HOST=${ollama_host}
      OLLAMA_MODEL=${ollama_model}
      OLLAMA_MODEL_DIGEST=${model_digest}
      OLLAMA_VERSION=${ollama_version}
      OLLAMA_NUM_PARALLEL=${ollama_num_parallel}
      OLLAMA_MAX_QUEUE=${ollama_max_queue}
      OLLAMA_KEEP_ALIVE=${ollama_keep_alive}
      OLLAMA_NUM_GPU=${ollama_num_gpu}
      PROXY_HTTPS_PORT=${proxy_https_port}
      PROXY_ACME_PORT=${proxy_acme_port}
      PROXY_ALLOWED_CIDR=${proxy_allowed_cidr}
      PROXY_HOSTNAME=${proxy_hostname}
      PROXY_ACME_EMAIL=${proxy_acme_email}
      PROXY_BEARER_SECRET_ARN=${proxy_bearer_secret_arn}
      TRIAL_DATA_DEVICE=${data_volume_device_name}
      CLOUDWATCH_LOG_RETENTION_DAYS=${cloudwatch_log_retention_days}

  # Ollama systemd drop-in. The bootstrap script installs the unit and reloads it.
  # TODO(T022): the effective values are re-applied by bootstrap.sh from trial.env so
  # a manual re-run is idempotent; keep both paths in sync.
  - path: /etc/systemd/system/ollama.service.d/10-trial.conf
    permissions: "0644"
    owner: root:root
    content: |
      [Service]
      Environment="OLLAMA_HOST=${ollama_host}"
      Environment="OLLAMA_NUM_PARALLEL=${ollama_num_parallel}"
      Environment="OLLAMA_MAX_QUEUE=${ollama_max_queue}"
      Environment="OLLAMA_KEEP_ALIVE=${ollama_keep_alive}"
      Environment="OLLAMA_NUM_GPU=${ollama_num_gpu}"

  # Placeholder for the CloudWatch agent configuration (metrics/logs, 14-day retention).
  # TODO(T043): replace with the real agent config for Nginx/Ollama/CPU/RAM/disk.
  - path: /opt/ollama-trial/todo-cloudwatch-agent.md
    permissions: "0644"
    owner: root:root
    content: |
      Feature 032 - TODO(T043): CloudWatch agent, log group and metric filters are not
      configured yet. Until then the trial runs without EC2 metrics and must not be
      reported as SC-007 complete.

runcmd:
  - [ bash, "-c", "install -d -m 0700 /opt/ollama-trial" ]
  - [ bash, "-c", "install -d -m 0755 /var/lib/ollama" ]
  # TODO(T019): main.tf must upload deployments/ollama/bootstrap.sh and
  # deployments/ollama/nginx-ollama.conf.template to /opt/ollama-trial/ before the
  # next step runs. The bootstrap script aborts if either file or trial.env is missing.
  - [ bash, "-lc", "/opt/ollama-trial/bootstrap.sh > /var/log/ollama-trial-bootstrap.log 2>&1" ]
  # TODO(T022): make bootstrap.sh responsible for "systemctl enable --now ollama nginx"
  # so a manual re-run and a fresh boot follow the same path.
  - [ bash, "-lc", "systemctl enable ollama nginx || true" ]

final_message: "Feature 032 Ollama trial host bootstrap finished; verify with the runbook section B2."
