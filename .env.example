# ==============================================================================
# NGROK WEBHOOK TUNNEL
# ==============================================================================
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your_custom_static_domain_here
NGROK_TARGET=http://nginx:80

# ==============================================================================
# 020-PLATFORM-MIGRATION — runtime profile & env-driven infrastructure
# Defaults live in configs/*.yaml; set here only what differs per environment.
# ==============================================================================
# APP_MODE: all (local/VPS) | http (Cloud Run HTTP) | worker (Cloud Run worker)
APP_MODE=all
# SERVER_ENV: local / vps-legacy / vps / managed / managed-drill
SERVER_ENV=local
# Port precedence: PORT (Cloud Run) > SERVER_PORT (top) > server.port in YAML.
PORT=

# --- Hosts/endpoints (FR-005: no hardcode) ---
DB_HOST=localhost
DB_SSLMODE=disable
DB_LISTENER_HOST=localhost
DB_DRILL_SCHEMA=
# Per-service Goose version table (FR-035): account=goose_db_version (default),
# commerce=goose_db_version_commerce, ai=goose_db_version_ai.
DATABASE_MIGRATION_TABLE=
REDIS_HOST=localhost
RABBITMQ_HOST=localhost

# --- Search engine (default OFF, FR-001) ---
ELASTICSEARCH_ADDRESSES=http://localhost:9200

# --- Asymmetric JWT (FR-022; HS256 default, ES256 in managed) ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Ingress (required only in managed profiles) ---
INGRESS_ACCOUNT_URL=
INGRESS_COMMERCE_URL=
INGRESS_AI_URL=
INGRESS_TOKEN_HELPER_URL=
INGRESS_TOKEN_AUDIENCE=
