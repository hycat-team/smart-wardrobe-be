# ==============================================================================
# LOCAL DEVELOPMENT (.env)
# Copy this file to .env and fill in values. NEVER commit .env (gitignored).
# Key names must stay in sync with .env.example. Defaults live in configs/*.yaml.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# APP_MODE: all (local/VPS) | http (cloud http) | worker (cloud worker)
APP_MODE=all
# SERVER_ENV: local / vps / managed
SERVER_ENV=local
# Port precedence: PORT (Cloud Run) > SERVER_PORT > server.port in YAML.
PORT=
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. PUBLIC API, DOMAINS & INGRESS
# ------------------------------------------------------------------------------
# REQUIRED: CORS origins, comma-separated.
FRONT_END_ORIGIN=
# Optional: Swagger UI gate (enforced when SERVER_ENV=production).
SWAGGER_ACCESS_CODE=
# Cloud only: upstream URLs + ID-token audience. Leave empty locally.
INGRESS_ACCOUNT_URL=
INGRESS_COMMERCE_URL=
INGRESS_AI_URL=
INGRESS_TOKEN_AUDIENCE=

# ------------------------------------------------------------------------------
# 3. DATABASE (keep all DB_* together)
# ------------------------------------------------------------------------------
DB_USER=admin
DB_PASSWORD=your_password
DB_NAME=smart_wardrobe_db
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_LISTENER_HOST=localhost
# Optional: drill-only schema (drill_<date>_<n>); empty = no drill.
DB_DRILL_SCHEMA=
# Optional: per-service Goose table; empty = account default (goose_db_version).
DATABASE_MIGRATION_TABLE=

# ------------------------------------------------------------------------------
# 4. REDIS
# ------------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_HOST=localhost

# ------------------------------------------------------------------------------
# 5. RABBITMQ
# ------------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=123456
RABBITMQ_PORT=5672
RABBITMQ_HOST=localhost

# ------------------------------------------------------------------------------
# 6. ELASTICSEARCH (default OFF)
# ------------------------------------------------------------------------------
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ADDRESSES=http://localhost:9200

# ------------------------------------------------------------------------------
# 7. JWT (HS256 needs SECRET only; ES256 also needs the PEM pair)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 8. EMAIL SMTP
# ------------------------------------------------------------------------------
EMAIL_SENDER_EMAIL=your_email@gmail.com
EMAIL_SMTP_USER=your_account_email
EMAIL_SMTP_KEY=your_smtp_key
EMAIL_REPLY_TO=

# ------------------------------------------------------------------------------
# 9. PAYOS
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_ENDPOINT=https://api-merchant.payos.vn

# ------------------------------------------------------------------------------
# 10. CLOUDINARY
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_URL=https://api.cloudinary.com

# ------------------------------------------------------------------------------
# 11. AI PROVIDERS: VISION / EMBEDDING / CHAT_TEXT / RECOMMENDATION_TEXT / FREE_TEXT
# Each capability: PRIMARY_* + FALLBACK_* (provider/api_key/endpoint/model). Empty = disabled.
# ------------------------------------------------------------------------------
# --- VISION ---
VISION_PRIMARY_PROVIDER=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_ENDPOINT=
VISION_PRIMARY_MODEL=
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_ENDPOINT=
VISION_FALLBACK_MODEL=

# --- EMBEDDING ---
EMBEDDING_PRIMARY_PROVIDER=
EMBEDDING_PRIMARY_API_KEY=
EMBEDDING_PRIMARY_ENDPOINT=
EMBEDDING_PRIMARY_MODEL=
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_ENDPOINT=
EMBEDDING_FALLBACK_MODEL=

# --- CHAT_TEXT ---
CHAT_TEXT_PRIMARY_PROVIDER=
CHAT_TEXT_PRIMARY_API_KEY=
CHAT_TEXT_PRIMARY_ENDPOINT=
CHAT_TEXT_PRIMARY_MODEL=
CHAT_TEXT_FALLBACK_PROVIDER=
CHAT_TEXT_FALLBACK_API_KEY=
CHAT_TEXT_FALLBACK_ENDPOINT=
CHAT_TEXT_FALLBACK_MODEL=

# --- RECOMMENDATION_TEXT ---
RECOMMENDATION_TEXT_PRIMARY_PROVIDER=
RECOMMENDATION_TEXT_PRIMARY_API_KEY=
RECOMMENDATION_TEXT_PRIMARY_ENDPOINT=
RECOMMENDATION_TEXT_PRIMARY_MODEL=
RECOMMENDATION_TEXT_FALLBACK_PROVIDER=
RECOMMENDATION_TEXT_FALLBACK_API_KEY=
RECOMMENDATION_TEXT_FALLBACK_ENDPOINT=
RECOMMENDATION_TEXT_FALLBACK_MODEL=

# --- FREE_TEXT ---
FREE_TEXT_PRIMARY_PROVIDER=google
FREE_TEXT_PRIMARY_API_KEY=
FREE_TEXT_PRIMARY_ENDPOINT=
FREE_TEXT_PRIMARY_MODEL=
FREE_TEXT_FALLBACK_PROVIDER=
FREE_TEXT_FALLBACK_API_KEY=
FREE_TEXT_FALLBACK_ENDPOINT=
FREE_TEXT_FALLBACK_MODEL=

# ------------------------------------------------------------------------------
# 12. LOCAL ONLY: NGROK WEBHOOK TUNNEL
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your_custom_static_domain_here
NGROK_TARGET=http://nginx:80
