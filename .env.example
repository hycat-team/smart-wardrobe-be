# ==============================================================================
# LOCAL DEVELOPMENT (.env)
# Copy this file to .env and fill in values. NEVER commit .env (gitignored).
# Key names must stay in sync with .env.example. Defaults live in configs/*.yaml.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# APP_MODE: all (local/VPS) | http (cloud http) | worker (cloud worker)
APP_MODE=all
# SERVER_ENV: local / vps
SERVER_ENV=local
# Port precedence: PORT (cloud) > SERVER_PORT > server.port in YAML.
PORT=
SERVER_PORT=8080
# Optional: SSE replay buffer size (events per analysis session) and TTL in seconds.
# Empty = use configs/config.yaml defaults (100 / 300).
SSE_REPLAY_BUFFER_SIZE=
SSE_REPLAY_BUFFER_TTL_SECONDS=

# ------------------------------------------------------------------------------
# 2. PUBLIC API, DOMAINS & INGRESS
# ------------------------------------------------------------------------------
# REQUIRED: CORS origins, comma-separated.
FRONT_END_ORIGIN=
# Optional: session cookie Domain attribute. Empty = host-only (local/dev).
# Production: set to the shared parent domain, e.g. closy.hycat.online.
COOKIE_DOMAIN=
# Optional: Swagger UI gate (enforced when SERVER_ENV is not local/dev).
SWAGGER_ACCESS_CODE=
# Cloud only: upstream URLs + ID-token audience. Leave empty locally.
INGRESS_ACCOUNT_URL=
INGRESS_COMMERCE_URL=
INGRESS_AI_URL=
INGRESS_TOKEN_AUDIENCE=

# ------------------------------------------------------------------------------
# 3. DATABASE (keep all DB_* together)
# ------------------------------------------------------------------------------
DB_USER=admin
DB_PASSWORD=your_password
DB_NAME=smart_wardrobe_db
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_LISTENER_HOST=localhost
# Optional: drill-only schema (drill_<date>_<n>); empty = no drill.
DB_DRILL_SCHEMA=
# Optional: per-service Goose table; empty = account default (goose_db_version).
DATABASE_MIGRATION_TABLE=

# ------------------------------------------------------------------------------
# 4. REDIS
# ------------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_HOST=localhost

# ------------------------------------------------------------------------------
# 5. RABBITMQ
# ------------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=123456
RABBITMQ_PORT=5672
RABBITMQ_HOST=localhost

# ------------------------------------------------------------------------------
# 6. ELASTICSEARCH (default OFF)
# ------------------------------------------------------------------------------
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ADDRESSES=http://localhost:9200

# ------------------------------------------------------------------------------
# 7. JWT (HS256 needs SECRET only; ES256 also needs the PEM pair)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH (Social Login)
# ------------------------------------------------------------------------------
# Web application OAuth client ID. This is the ONLY client used for the web login
# redirect flow, so it MUST be a "Web application" client — never an Android or
# iOS client, which Google rejects with redirect_uri_mismatch.
GOOGLE_WEB_CLIENT_ID=
# Web application client secret. Both web settings are required whenever
# GOOGLE_REDIRECT_URI is set; startup fails otherwise.
GOOGLE_WEB_CLIENT_SECRET=
# Optional: comma-separated iOS/Android client IDs accepted as ID token
# audiences. Do NOT list the web client here — it is always accepted.
GOOGLE_CLIENT_IDS=
# Backend callback URL; must be registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=
# Optional: CSRF state TTL in minutes (default 10 in configs/config.yaml).
GOOGLE_STATE_TTL_MINUTES=

# ------------------------------------------------------------------------------
# 9. EMAIL SMTP
# ------------------------------------------------------------------------------
# Email switch. Missing means "send". Set to false for a bulk verification run.
EMAIL_ENABLED=true
EMAIL_SENDER_EMAIL=your_email@gmail.com
EMAIL_SMTP_USER=your_account_email
EMAIL_SMTP_KEY=your_smtp_key
EMAIL_REPLY_TO=

# ------------------------------------------------------------------------------
# 10. PAYOS
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_ENDPOINT=https://api-merchant.payos.vn

# ------------------------------------------------------------------------------
# 11. CLOUDINARY
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_URL=https://api.cloudinary.com

# ------------------------------------------------------------------------------
# 12. AI PROVIDERS: VISION / EMBEDDING / CHAT_TEXT / RECOMMENDATION_TEXT / FREE_TEXT
# Each capability: PRIMARY_* + FALLBACK_* (provider/api_key/endpoint/model). Empty = disabled.
# ------------------------------------------------------------------------------
# --- VISION ---
VISION_PRIMARY_PROVIDER=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_ENDPOINT=
VISION_PRIMARY_MODEL=
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_ENDPOINT=
VISION_FALLBACK_MODEL=

# --- EMBEDDING ---
EMBEDDING_PRIMARY_PROVIDER=
EMBEDDING_PRIMARY_API_KEY=
EMBEDDING_PRIMARY_ENDPOINT=
EMBEDDING_PRIMARY_MODEL=
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_ENDPOINT=
EMBEDDING_FALLBACK_MODEL=

# --- CHAT_TEXT ---
CHAT_TEXT_PRIMARY_PROVIDER=
CHAT_TEXT_PRIMARY_API_KEY=
CHAT_TEXT_PRIMARY_ENDPOINT=
CHAT_TEXT_PRIMARY_MODEL=
CHAT_TEXT_FALLBACK_PROVIDER=
CHAT_TEXT_FALLBACK_API_KEY=
CHAT_TEXT_FALLBACK_ENDPOINT=
CHAT_TEXT_FALLBACK_MODEL=

# --- RECOMMENDATION_TEXT ---
RECOMMENDATION_TEXT_PRIMARY_PROVIDER=
RECOMMENDATION_TEXT_PRIMARY_API_KEY=
RECOMMENDATION_TEXT_PRIMARY_ENDPOINT=
RECOMMENDATION_TEXT_PRIMARY_MODEL=
RECOMMENDATION_TEXT_FALLBACK_PROVIDER=
RECOMMENDATION_TEXT_FALLBACK_API_KEY=
RECOMMENDATION_TEXT_FALLBACK_ENDPOINT=
RECOMMENDATION_TEXT_FALLBACK_MODEL=

# --- FREE_TEXT ---
FREE_TEXT_PRIMARY_PROVIDER=google
FREE_TEXT_PRIMARY_API_KEY=
FREE_TEXT_PRIMARY_ENDPOINT=
FREE_TEXT_PRIMARY_MODEL=
FREE_TEXT_FALLBACK_PROVIDER=
FREE_TEXT_FALLBACK_API_KEY=
FREE_TEXT_FALLBACK_ENDPOINT=
FREE_TEXT_FALLBACK_MODEL=

# Capabilities whose provider key is not billed (comma-separated).
# Allowed: vision, embedding, chat_text, recommendation_text, free_text.
# Anything not listed is billed; empty means everything is billed.
AI_UNBILLED_CAPABILITIES=free_text,embedding

# ------------------------------------------------------------------------------
# 13. LOCAL ONLY: NGROK WEBHOOK TUNNEL
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your_custom_static_domain_here
NGROK_TARGET=http://nginx:80

# ------------------------------------------------------------------------------
# 14. SIGNUP CAMPAIGN GRANT (025, moved to the database in 026)
#    — NO ENVIRONMENT VARIABLES HERE
# ------------------------------------------------------------------------------
# Campaigns are DATA and they live in the table `subscription.campaigns`, which
# the admin API writes (026). Opening a campaign is
# POST /api/v1/admin/campaigns, closing one is
# POST /api/v1/admin/campaigns/{code}/close — neither is a commit or a deploy.
#
# Because the DATABASE is the environment boundary (every deployment has its own
# database), campaign values differ per environment with no variable here at all.
# That is the whole of 026's answer to "how do I promote only to staging": point
# the deployment at its own database.
#
# `campaign_sweep` (interval_seconds, run_on_start) is still YAML, on purpose: the
# cadence belongs to the deployment rather than to any campaign, and keeping
# configuration loading free of database access depends on it staying here.
#
# Do not add a CAMPAIGN_* key to this file. A second configuration path for one
# meaning is exactly what 026 removed.
