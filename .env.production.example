# ==============================================================================
# PRODUCTION ON VPS (/opt/closy/.env.production)
# Fill in and copy to /opt/closy/.env.production (chmod 600). NEVER commit (gitignored).
# Key names must stay in sync with .env.production.example.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# APP_MODE: all (VPS runs http+worker in one process).
APP_MODE=all
# SERVER_ENV: vps (local docker infra). The cloud box (Phase 2) also uses vps profile values.
SERVER_ENV=vps
PORT=
# Container timezone.
TZ=Asia/Ho_Chi_Minh
# Optional: SSE replay buffer size (events per analysis session) and TTL in seconds.
# Empty = use configs/config.production.yaml defaults (100 / 300).
SSE_REPLAY_BUFFER_SIZE=
SSE_REPLAY_BUFFER_TTL_SECONDS=

# ------------------------------------------------------------------------------
# 2. COMPOSE, DOMAINS & INGRESS
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=
# LEGACY: image of the old monolith stack. Not read by the current compose file.
BACKEND_IMAGE=
API_DOMAIN=
API_V2_DOMAIN=
NGINX_CLIENT_MAX_BODY_SIZE=20m
BACKEND_HEALTH_PATH=/api/v1/health
# NGINX_MODE: services | services-redirect | rollback
#   services          : api.closy.hycat.online -> 3 services (steady state, monolith stopped)
#   services-redirect : services + api-v2 -> 301 -> api.closy (grace after external box off)
#   rollback          : api.closy -> monolith (backend), api-v2 -> 301 -> api.closy (emergency)
NGINX_MODE=services
# 3-service images (ACCOUNT_IMAGE/COMMERCE_IMAGE/AI_IMAGE) come from .env.deploy
# (written by deploy-vps-services.yml) — do NOT set them here.
# Internal gRPC between the 3 compose services (Commerce -> Account/AI, AI -> Account).
INGRESS_ACCOUNT_URL=http://account:8080
INGRESS_COMMERCE_URL=http://commerce:8080
INGRESS_AI_URL=http://ai:8080
# Cloud only (audience). Leave empty on VPS.
INGRESS_TOKEN_AUDIENCE=
# REQUIRED: CORS origins, comma-separated.
FRONT_END_ORIGIN=
# Optional: session cookie Domain attribute. Empty = host-only (local/dev).
# Production: set to the shared parent domain, e.g. closy.hycat.online.
COOKIE_DOMAIN=
# Optional: Swagger UI gate (enforced when SERVER_ENV is not local/dev).
SWAGGER_ACCESS_CODE=

# ------------------------------------------------------------------------------
# 3. DATABASE — VPS always uses local docker Postgres (never managed hostnames)
# ------------------------------------------------------------------------------
DB_USER=closy
DB_PASSWORD=replace_with_a_long_random_database_password
DB_NAME=closy
DB_HOST=postgres
DB_SSLMODE=disable
DB_LISTENER_HOST=postgres
# Optional: drill-only schema (drill_<date>_<n>); empty = no drill.
DB_DRILL_SCHEMA=
# Optional: per-service Goose table (compose sets it per service); empty = account default.
DATABASE_MIGRATION_TABLE=

# ------------------------------------------------------------------------------
# 4. REDIS (local docker)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_a_long_random_redis_password
REDIS_HOST=redis

# ------------------------------------------------------------------------------
# 5. RABBITMQ (local docker)
# ------------------------------------------------------------------------------
RABBITMQ_USER=closy
RABBITMQ_PASSWORD=replace_with_a_long_random_rabbitmq_password
RABBITMQ_HOST=rabbitmq

# ------------------------------------------------------------------------------
# 6. ELASTICSEARCH (default OFF)
# ------------------------------------------------------------------------------
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ADDRESSES=http://elasticsearch:9200

# ------------------------------------------------------------------------------
# 7. JWT (HS256 needs SECRET only; ES256 also needs the PEM pair)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH (Social Login)
# ------------------------------------------------------------------------------
# Comma-separated OAuth client IDs: web, iOS, Android.
GOOGLE_CLIENT_IDS=
# Web Authorization Code flow only; leave empty if web uses ID token (GIS).
GOOGLE_CLIENT_SECRET=
# Backend callback URL; must be registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=
# Optional: CSRF state TTL in minutes (default 10 in configs/config.yaml).
GOOGLE_STATE_TTL_MINUTES=

# ------------------------------------------------------------------------------
# 9. EMAIL SMTP
# ------------------------------------------------------------------------------
EMAIL_SENDER_EMAIL=replace_with_the_production_sender_email
EMAIL_SMTP_USER=replace_with_the_account_email
EMAIL_SMTP_KEY=replace_with_the_smtp_key
EMAIL_REPLY_TO=

# ------------------------------------------------------------------------------
# 10. PAYOS
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=replace_with_the_production_payos_client_id
PAYOS_API_KEY=replace_with_the_production_payos_api_key
PAYOS_CHECKSUM_KEY=replace_with_the_production_payos_checksum_key
PAYOS_ENDPOINT=https://api-merchant.payos.vn

# ------------------------------------------------------------------------------
# 11. CLOUDINARY
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=replace_with_the_production_cloud_name
CLOUDINARY_API_KEY=replace_with_the_production_api_key
CLOUDINARY_API_SECRET=replace_with_the_production_api_secret
CLOUDINARY_API_URL=https://api.cloudinary.com

# ------------------------------------------------------------------------------
# 12. AI PROVIDERS: VISION / EMBEDDING / CHAT_TEXT / RECOMMENDATION_TEXT / FREE_TEXT
# Each capability: PRIMARY_* + FALLBACK_* (provider/api_key/endpoint/model). Empty = disabled.
# ------------------------------------------------------------------------------
# --- VISION ---
VISION_PRIMARY_PROVIDER=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_ENDPOINT=
VISION_PRIMARY_MODEL=
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_ENDPOINT=
VISION_FALLBACK_MODEL=

# --- EMBEDDING ---
EMBEDDING_PRIMARY_PROVIDER=
EMBEDDING_PRIMARY_API_KEY=
EMBEDDING_PRIMARY_ENDPOINT=
EMBEDDING_PRIMARY_MODEL=
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_ENDPOINT=
EMBEDDING_FALLBACK_MODEL=

# --- CHAT_TEXT ---
CHAT_TEXT_PRIMARY_PROVIDER=
CHAT_TEXT_PRIMARY_API_KEY=
CHAT_TEXT_PRIMARY_ENDPOINT=
CHAT_TEXT_PRIMARY_MODEL=
CHAT_TEXT_FALLBACK_PROVIDER=
CHAT_TEXT_FALLBACK_API_KEY=
CHAT_TEXT_FALLBACK_ENDPOINT=
CHAT_TEXT_FALLBACK_MODEL=

# --- RECOMMENDATION_TEXT ---
RECOMMENDATION_TEXT_PRIMARY_PROVIDER=
RECOMMENDATION_TEXT_PRIMARY_API_KEY=
RECOMMENDATION_TEXT_PRIMARY_ENDPOINT=
RECOMMENDATION_TEXT_PRIMARY_MODEL=
RECOMMENDATION_TEXT_FALLBACK_PROVIDER=
RECOMMENDATION_TEXT_FALLBACK_API_KEY=
RECOMMENDATION_TEXT_FALLBACK_ENDPOINT=
RECOMMENDATION_TEXT_FALLBACK_MODEL=

# --- FREE_TEXT ---
FREE_TEXT_PRIMARY_PROVIDER=google
FREE_TEXT_PRIMARY_API_KEY=
FREE_TEXT_PRIMARY_ENDPOINT=
FREE_TEXT_PRIMARY_MODEL=
FREE_TEXT_FALLBACK_PROVIDER=
FREE_TEXT_FALLBACK_API_KEY=
FREE_TEXT_FALLBACK_ENDPOINT=
FREE_TEXT_FALLBACK_MODEL=

# ------------------------------------------------------------------------------
# 13. SIGNUP CAMPAIGN GRANT (025) — NO ENVIRONMENT VARIABLES HERE
# ------------------------------------------------------------------------------
# Environment overrides apply to SINGLE values only. The signup campaign grant is
# two things this file therefore cannot carry, and both live in the YAML files
# (configs/config.yaml, configs/config.production.yaml) instead:
#   - campaigns:        the campaign LIST — code, plan_slug, quota, reserve,
#                       starts_at, ends_at. A list cannot be expressed as one
#                       environment value, so there is no CAMPAIGN_* variable
#                       that would override it.
#   - campaign_sweep:   the catch-up sweep interval (interval_seconds) and
#                       run_on_start. It sits next to the campaigns it sweeps,
#                       so adding a variable for it would create a SECOND
#                       configuration path for the same meaning.
# To change quota, reserve or the sweep interval, edit the YAML file — the same
# way any other campaign value is changed. Do not add CAMPAIGN_* keys here.
