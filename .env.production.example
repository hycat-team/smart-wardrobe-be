# ==============================================================================
# COMPOSE DEPLOYMENT
# ==============================================================================
COMPOSE_PROJECT_NAME=
BACKEND_IMAGE=

# ==============================================================================
# NGINX AND PUBLIC API
# ==============================================================================
API_DOMAIN=
API_V2_DOMAIN=
NGINX_CLIENT_MAX_BODY_SIZE=20m
BACKEND_HEALTH_PATH=/api/v1/health
# Which server-block set Nginx renders: parallel | parallel-v2 | repatriation | rollback
#   parallel      : api.closy -> monolith (backend), api-v2 -> Cloud Run
#   parallel-v2   : api.closy -> 3 services, api-v2 -> Cloud Run (no monolith)
#   repatriation  : api.closy -> 3 services, api-v2 -> 301 -> api.closy
#   rollback      : api.closy -> monolith (backend), api-v2 -> 301 -> api.closy
NGINX_MODE=parallel
# Enable the token-helper compose profile so it starts (api-v2 -> Cloud Run):
# COMPOSE_PROFILES=parallel for mode parallel, parallel-v2 for mode parallel-v2.
# Leave empty for repatriation/rollback.
COMPOSE_PROFILES=parallel
# 3-service images (ACCOUNT_IMAGE/COMMERCE_IMAGE/AI_IMAGE) are REQUIRED whenever
# nginx starts because it depends_on account/commerce/ai. They come from the
# .env.deploy file written by deploy-vps-services.yml — do NOT set them here.
# Cloud Run service URLs (required by the parallel/parallel-v2 api-v2 ingress).
ACCOUNT_RUN_URL=
COMMERCE_RUN_URL=
AI_RUN_URL=
# Nginx reaches token-helper by service name inside the compose network.
TOKEN_HELPER_URL=http://token-helper:8082
# Absolute host path to the least-privilege service-account key JSON (mode 0600).
# Must be absolute: compose resolves relative paths against deployments/, so a
# relative path would point at deployments/token-helper-sa.json instead of /opt/closy.
TOKEN_HELPER_SA_KEY_FILE=/opt/closy/token-helper-sa.json

# ==============================================================================
# CONTAINER TIMEZONE
# ==============================================================================
TZ=Asia/Ho_Chi_Minh

# ==============================================================================
# SERVER & SWAGGER ACCESS
# ==============================================================================
FRONT_END_ORIGIN=
SWAGGER_ACCESS_CODE=

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET=replace_with_a_long_random_jwt_secret

# ==============================================================================
# POSTGRESQL
# ==============================================================================
DB_USER=closy
DB_PASSWORD=replace_with_a_long_random_database_password
DB_NAME=closy

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_PASSWORD=replace_with_a_long_random_redis_password

# ==============================================================================
# RABBITMQ
# ==============================================================================
RABBITMQ_USER=closy
RABBITMQ_PASSWORD=replace_with_a_long_random_rabbitmq_password

# ==============================================================================
# ELASTICSEARCH
# ==============================================================================
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# ==============================================================================
# EMAIL SMTP
# ==============================================================================
EMAIL_SENDER_EMAIL=replace_with_the_production_sender_email
EMAIL_SMTP_USER=replace_with_the_account_email
EMAIL_SMTP_KEY=replace_with_the_smtp_key
EMAIL_REPLY_TO=

# ==============================================================================
# PAYOS
# ==============================================================================
PAYOS_CLIENT_ID=replace_with_the_production_payos_client_id
PAYOS_API_KEY=replace_with_the_production_payos_api_key
PAYOS_CHECKSUM_KEY=replace_with_the_production_payos_checksum_key
PAYOS_ENDPOINT=https://api-merchant.payos.vn

# ==============================================================================
# CLOUDINARY
# ==============================================================================
CLOUDINARY_CLOUD_NAME=replace_with_the_production_cloud_name
CLOUDINARY_API_KEY=replace_with_the_production_api_key
CLOUDINARY_API_SECRET=replace_with_the_production_api_secret
CLOUDINARY_API_URL=https://api.cloudinary.com

# ==============================================================================
# AI VISION PROVIDERS
# ==============================================================================
VISION_PRIMARY_PROVIDER=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_ENDPOINT=
VISION_PRIMARY_MODEL=
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_ENDPOINT=
VISION_FALLBACK_MODEL=

# ==============================================================================
# AI EMBEDDING PROVIDERS
# ==============================================================================
EMBEDDING_PRIMARY_PROVIDER=
EMBEDDING_PRIMARY_API_KEY=
EMBEDDING_PRIMARY_ENDPOINT=
EMBEDDING_PRIMARY_MODEL=
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_ENDPOINT=
EMBEDDING_FALLBACK_MODEL=

# ==============================================================================
# AI CHAT TEXT PROVIDERS
# ==============================================================================
CHAT_TEXT_PRIMARY_PROVIDER=
CHAT_TEXT_PRIMARY_API_KEY=
CHAT_TEXT_PRIMARY_ENDPOINT=
CHAT_TEXT_PRIMARY_MODEL=
CHAT_TEXT_FALLBACK_PROVIDER=
CHAT_TEXT_FALLBACK_API_KEY=
CHAT_TEXT_FALLBACK_ENDPOINT=
CHAT_TEXT_FALLBACK_MODEL=

# ==============================================================================
# AI RECOMMENDATION TEXT PROVIDERS
# ==============================================================================
RECOMMENDATION_TEXT_PRIMARY_PROVIDER=
RECOMMENDATION_TEXT_PRIMARY_API_KEY=
RECOMMENDATION_TEXT_PRIMARY_ENDPOINT=
RECOMMENDATION_TEXT_PRIMARY_MODEL=
RECOMMENDATION_TEXT_FALLBACK_PROVIDER=
RECOMMENDATION_TEXT_FALLBACK_API_KEY=
RECOMMENDATION_TEXT_FALLBACK_ENDPOINT=
RECOMMENDATION_TEXT_FALLBACK_MODEL=

# ==============================================================================
# AI FREE TEXT PROVIDERS
# ==============================================================================
FREE_TEXT_PRIMARY_PROVIDER=google
FREE_TEXT_PRIMARY_API_KEY=
FREE_TEXT_PRIMARY_ENDPOINT=
FREE_TEXT_PRIMARY_MODEL=
FREE_TEXT_FALLBACK_PROVIDER=
FREE_TEXT_FALLBACK_API_KEY=
FREE_TEXT_FALLBACK_ENDPOINT=
FREE_TEXT_FALLBACK_MODEL=
# ==============================================================================
# 020-PLATFORM-MIGRATION — profile `vps` (repatriation/self-host)
# Defaults live in configs/*.yaml; managed deploy overrides via deploy-platform.yml.
# ==============================================================================
APP_MODE=all
SERVER_ENV=vps
PORT=

DB_HOST=postgres
DB_SSLMODE=disable
DB_LISTENER_HOST=postgres
DB_DRILL_SCHEMA=
# Per-service Goose version table (FR-035); deploy sets one value per service.
DATABASE_MIGRATION_TABLE=
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq

ELASTICSEARCH_ADDRESSES=http://elasticsearch:9200

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# gRPC giữa 3 service compose (Commerce → Account/AI, AI → Account).
INGRESS_ACCOUNT_URL=http://account:8080
INGRESS_COMMERCE_URL=http://commerce:8080
INGRESS_AI_URL=http://ai:8080
INGRESS_TOKEN_HELPER_URL=
INGRESS_TOKEN_AUDIENCE=
