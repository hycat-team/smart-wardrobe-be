  "info": {
    "contact": {},
    "description": "API docs for the AI Engine service (aiexecutor).",
    "title": "Smart Wardrobe - AI Service API",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/admin/ai/cost-policies": {
      "get": {
        "description": "Quản trị viên xem cổng 2 của từng gói: chế độ thi hành, trần chi phí và giới hạn lượt của từng thao tác.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/presentation.APIResponse"
                },
                {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/definitions/smart-wardrobe-be_services_ai_dto_aiexecutor.AICostPolicyDTO"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "summary": "Danh sách chính sách chi phí AI (cổng 2)",
        "tags": [
          "Admin AI"
        ]
      }
    },
    "/api/v1/admin/ai/cost-policies/{id}/operations/{operation}": {
      "put": {
        "consumes": [
          "application/json"
        ],
        "description": "Sửa maxPaidAttemptsPerDay. Trường này thuộc nhóm quyền lợi đã đóng băng nên cần phát lại tín hiệu (FR-029c) mới có tác dụng.",
        "parameters": [
          {
            "description": "Operation ID",
            "format": "uuid",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "Tên thao tác",
            "enum": [
              "outfit",
              "chat",
              "rewriter",
              "summary"
            ],
            "in": "path",
            "name": "operation",
            "required": true,
            "type": "string"
          },
          {
            "description": "Thông tin cập nhật",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/smart-wardrobe-be_services_ai_dto_aiexecutor.UpdateCostPolicyOperationReq"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/presentation.APIResponse"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/smart-wardrobe-be_services_ai_dto_aiexecutor.UpdateCostPolicyOperationResp"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "summary": "Cập nhật giới hạn lượt của một thao tác AI (cổng 2)",
        "tags": [
          "Admin AI"
        ]
      }
    },
    "/api/v1/admin/ai/grants": {
      "get": {
        "description": "Quản trị viên xem các lượt grant chính sách AI đã cấp cho người dùng.",
        "parameters": [
          {
            "description": "User ID",
            "in": "query",
            "name": "userId",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/presentation.APIResponse"
                },
                {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/definitions/smart-wardrobe-be_services_ai_dto_aiexecutor.AIPolicyGrantDTO"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "summary": "Danh sách hạn mức chính sách AI của người dùng",
        "tags": [
          "Admin AI"
        ]
      }
    },
    "/api/v1/admin/ai/pricing": {
      "get": {
        "description": "Quản trị viên xem danh sách bảng giá các model AI của các nhà cung cấp.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/presentation.APIResponse"
                },
                {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/definitions/smart-wardrobe-be_services_ai_dto_aiexecutor.AIModelConfigDTO"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "summary": "Danh sách cấu hình giá mô hình AI",
        "tags": [
          "Admin AI"
        ]
      }
    },
    "/api/v1/admin/ai/pricing/{id}": {
      "put": {
        "consumes": [
          "application/json"
        ],
        "description": "Quản trị viên cập nhật giá token hoặc tỷ giá quy đổi cho mô hình AI.",
        "parameters": [
          {
            "description": "Model Config ID",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "string"
          },
          {
            "description": "Thông tin cập nhật giá",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/smart-wardrobe-be_services_ai_dto_aiexecutor.UpdatePricingReq"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/presentation.APIResponse"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/smart-wardrobe-be_services_ai_dto_aiexecutor.AIModelConfigDTO"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "summary": "Cập nhật cấu hình giá mô hình AI",
        "tags": [
          "Admin AI"
        ]
      }
    },
    "/api/v1/admin/ai/usage": {
      "get": {
        "description": "Quản trị viên xem nhật ký sử dụng và chi phí AI của một người dùng.",
        "parameters": [
          {
            "description": "User ID",
            "in": "query",
            "name": "userId",
            "required": true,
            "type": "string"
          },
          {
            "description": "Từ ngày (YYYY-MM-DD)",
            "in": "query",
            "name": "fromDate",
            "type": "string"
          },
          {
            "description": "Đến ngày (YYYY-MM-DD)",
            "in": "query",
            "name": "toDate",
            "type": "string"
          },
          {
            "description": "Trang",
            "in": "query",
            "name": "page",
            "type": "integer"
          },
          {
            "description": "Số bản ghi/trang",
            "in": "query",
            "name": "limit",
            "type": "integer"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/presentation.APIResponse"
                },
                {
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.PaginationResult-smart-wardrobe-be_services_ai_dto_aiexecutor_AIUsageItemDTO"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "summary": "Lịch sử sử dụng AI của người dùng",
        "tags": [
          "Admin AI"
        ]
      }
    },
    "/api/v1/ai/health": {
      "get": {
        "description": "Liveness probe of the AI service, including the AI policy grant counters.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Liveness payload with status, service, time, mode and grant counters",
            "schema": {
              "type": "object"
            }
          }
        },
        "summary": "AI service liveness probe",
        "tags": [
          "AI Health"
        ]
      }
    }
  },
